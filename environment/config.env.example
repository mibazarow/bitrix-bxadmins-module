# Переменные окружения BXADMIN-S environment.
# install.sh сам создаёт environment.env в bxadmins-data/environment.
# Значения без кавычек и пробелов: файл читают и bash, и systemd EnvironmentFile.

SITE_ROOT=/home/bitrix/ext_www/example.ru
DATA_ROOT=/home/bitrix/bxadmins-data
ENV_HOME=/home/bitrix/bxadmins-data/environment
WEB_USER=bitrix

BXMCP_DIR=/home/bitrix/bxadmins-data/environment/bxmcp
BXMCP_PORT=3100
BXMCP_DB=/home/bitrix/bxadmins-data/environment/bxmcp/data/index.db
BXMCP_DOCS=/home/bitrix/bxadmins-data/environment/bxmcp/data/docs
BXMCP_DOCS_URL=
BITRIX_PATH=/home/bitrix/ext_www/example.ru/bitrix/modules
COMPONENTS_PATH=/home/bitrix/ext_www/example.ru/bitrix/components

NODE_BIN=/home/bitrix/bxadmins-data/environment/runtime/node/bin/node

EMBEDDINGS_DIR=/home/bitrix/bxadmins-data/environment/embeddings
EMBEDDINGS_PYTHON=/home/bitrix/bxadmins-data/environment/embeddings/venv/bin/python
EMBEDDING_PORT=8000
EMBEDDINGS_URL=http://127.0.0.1:8000
EMBEDDING_MODEL=google/embeddinggemma-2
EMBEDDING_DIM=256
EMBEDDING_MAX_SEQ=512
EMBEDDING_THREADS=2
HF_HOME=/home/bitrix/bxadmins-data/environment/models/huggingface
EMBEDDINGS_OFFLINE=0
CHROME_VERSION=156.0.7933.0
SCRAPLING_VERSION=

SCRAPLING_DIR=/home/bitrix/bxadmins-data/scrapling
SCRAPLING_PORT=3101
SCRAPLING_TOKEN=
SCRAPLING_BIN=/home/bitrix/bxadmins-data/scrapling/.venv/bin/scrapling-mcp
SCRAPLING_BROWSERS_DIR=/home/bitrix/bxadmins-data/scrapling/ms-playwright
PLAYWRIGHT_BROWSERS_PATH=/home/bitrix/bxadmins-data/scrapling/ms-playwright

CHROME_DIR=/home/bitrix/bxadmins-data/chrome
CHROME_BIN=/home/bitrix/bxadmins-data/chrome/chrome-headless-shell-linux64/chrome-headless-shell

