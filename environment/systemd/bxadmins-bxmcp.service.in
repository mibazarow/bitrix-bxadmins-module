[Unit]
Description=BXADMIN-S BxMCP (Bitrix MCP)
After=network.target bxadmins-embeddings.service
Wants=bxadmins-embeddings.service

[Service]
Type=simple
User=@WEB_USER@
Group=@WEB_USER@
WorkingDirectory=@BXMCP_DIR@
EnvironmentFile=@CONFIG_FILE@
Environment=PORT=@BXMCP_PORT@
ExecStart=@NODE_BIN@ dist/index.js
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
